# Copy to frontend/.env.local for local runs. On Vercel, set these in Project Settings > Environment Variables.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_...) or, on older projects, the anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The FastAPI backend: http://localhost:8000 locally, the Cloud Run URL in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
